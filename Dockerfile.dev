# OMP web-pentest dev environment (committed with the fork)
# Bun 1.3.14 = the repo's packageManager. Python + node for scanners/crawler bundles.
# Chromium is installed AT IMAGE BUILD from the workspace's PINNED playwright
# (packages/hackbrowser -> playwright 1.58.2 -> chromium-1208): the lockfile
# makes this deterministic, and baking it in keeps every ephemeral `docker run`
# chromium-ready (the pinned install must happen after `bun install`).
FROM oven/bun:1.3.14

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip nodejs git curl ca-certificates xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages requests aiohttp urllib3

# Workspace install + pinned chromium (with system deps) for the crawler bundle.
WORKDIR /work
COPY bun.lock package.json ./
COPY patches patches/
COPY packages/hackbrowser/package.json packages/hackbrowser/
COPY python/robomp/web python/robomp/web
RUN bun install --filter @omp/hackbrowser && cd packages/hackbrowser && bunx playwright install --with-deps chromium chromium-headless-shell

WORKDIR /work
CMD ["bash"]

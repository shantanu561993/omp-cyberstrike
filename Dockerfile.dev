# OMP web-pentest dev environment (committed with the fork)
# Bun 1.3.14 = the repo's packageManager. Python + node for scanners/crawler bundles.
# NO chromium here: packages/hackbrowser pins playwright 1.58.2 (chromium-1208);
# it installs its own matching build in Step 6.2 with --with-deps.
FROM oven/bun:1.3.14

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip nodejs git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages requests aiohttp urllib3

WORKDIR /work
CMD ["bash"]
